                        }
                    ],
    "preparation":  [
                        "Finely chop the onion, green chili, and coriander leaves. Grate the ginger.",
                        "In a large mixing bowl, combine the ragi flour, chopped onion, green chili, grated ginger, chopped coriander leaves, salt, cumin seeds (if using), and curd.",
                        "Gradually add water, a little at a time, and knead the mixture to form a soft, pliable dough. The dough should not be too sticky or too dry."
                    ],
    "cooking_methods":  [
                            {
                                "mode":  "Stovetop / gas",
                                "applicable":  true,
                                "steps":  [
                                              "Heat a tawa or griddle over medium heat.",
                                              "Take a small portion of the dough (about the size of a golf ball) and place it on a lightly greased surface, such as parchment paper, a banana leaf, or a plastic sheet.",
                                              "Gently flatten the dough using your palm or a rolling pin, forming a thin, round roti of about 4-6 inches in diameter. You can dip your hands in water to prevent sticking.",
                                              "Carefully transfer the flattened roti to the hot tawa.",
                                              "Cook for 1-2 minutes until small bubbles appear on the surface. Apply a few drops of oil around the edges.",
                                              "Flip the roti and cook the other side for another 1-2 minutes, pressing gently with a spatula to ensure even cooking and light browning.",
                                              "Remove the cooked roti from the tawa when it is cooked through and has light brown spots. Repeat the process with the remaining dough."
                                          ]
