                            "quantity":  1.0,
                            "unit":  "small",
                            "grams":  100.0,
                            "is_extra":  false,
                            "notes":  "finely chopped"
                        },
                        {
                            "name":  "curd",
                            "quantity":  3.0,
                            "unit":  "tablespoons",
                            "grams":  45.0,
                            "is_extra":  false,
                            "notes":  ""
                        },
